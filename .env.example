# Configuración opcional para entorno local (sin Docker)
# Si no defines DB_HOST, el proyecto usa SQLite automáticamente sin necesidad de instalar MySQL.

# Para conectar a MySQL local o remoto:
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=bd_productos
# DB_USER=django
# DB_PASSWORD=django123

# Para forzar SQLite:
# USE_SQLITE=1
